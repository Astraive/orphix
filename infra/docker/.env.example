# Orphix Docker Environment
# Copy to .env and fill in real values

# ── Database ──────────────────────────────────────────
POSTGRES_DB=orphix
POSTGRES_USER=orphix
POSTGRES_PASSWORD=CHANGE_ME

# ── JWT & Encryption (shared across all services) ─────
JWT_SECRET=CHANGE_ME_min_32_chars
TOKEN_ENCRYPTION_KEY=CHANGE_ME_min_32_chars

# ── GitHub OAuth ──────────────────────────────────────
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:2605/auth/github/callback

# ── CORS & Redirect URIs ─────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:2605,http://localhost:2606,app://orphix
ALLOWED_REDIRECT_URIS=http://localhost:3000/auth/callback,http://localhost:2605/auth/callback,app://orphix/auth/callback
SPA_ORIGIN=http://localhost:3000
