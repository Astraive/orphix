# ══════════════════════════════════════════════════════
# Orphix — Environment Variables (all services)
# Copy to .env and fill in real values
# ══════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────
DATABASE_URL=postgres://orphix:orphix_dev@localhost:5432/orphix

# ── Redis ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth (shared across control + link APIs) ──────────
JWT_SECRET=CHANGE_ME_min_32_chars
TOKEN_ENCRYPTION_KEY=CHANGE_ME_min_32_chars

# ── Encryption (master key for @orphix/encryption) ───
ENCRYPTION_MASTER_KEY=CHANGE_ME_min_32_chars

# ── GitHub OAuth ──────────────────────────────────────
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:2605/auth/github/callback

# ── CORS & Redirects ─────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:2605,http://localhost:2606,app://orphix
ALLOWED_REDIRECT_URIS=http://localhost:3000/auth/callback,http://localhost:2605/auth/callback,app://orphix/auth/callback
SPA_ORIGIN=http://localhost:3000

# ── API Ports ─────────────────────────────────────────
# CONTROL_PORT=2605
# LINK_PORT=2606
# MARKETPLACE_PORT=2607

# ── Vite (web app build-time) ─────────────────────────
VITE_CONTROL_URL=http://localhost:2605
VITE_LINK_URL=http://localhost:2606
VITE_APP_URL=http://localhost:3000
