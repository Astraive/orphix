# Mobile App Environment Variables
# Copy to .env for local development
# EXPO_PUBLIC_ prefix exposes them to the app

# API URLs
# For Android emulator: use 10.0.2.2 instead of localhost
# For iOS simulator: localhost works
# For physical device: use your dev machine's LAN IP
EXPO_PUBLIC_CONTROL_URL=http://localhost:2605
EXPO_PUBLIC_LINK_URL=http://localhost:2606
