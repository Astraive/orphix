# Desktop App Environment Variables
# Copy to .env and fill in values
# These are read by Electron main process (Node.js) and Vite renderer

# API URLs (used by main process: link-manager, auth.ipc)
ORPHIX_CONTROL_URL=http://localhost:2605
ORPHIX_LINK_URL=ws://localhost:2606
ORPHIX_WEB_URL=http://localhost:3000

# Vite renderer URLs (auto-derived from ORPHIX_ vars via electron.vite.config.ts)
# VITE_CONTROL_URL and VITE_LINK_URL are set automatically — no need to set these
