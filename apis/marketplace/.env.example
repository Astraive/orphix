# Marketplace API Environment Variables
# Copy to .env and fill in values

# Server
PORT=2607

# Database
DATABASE_URL=postgres://orphix:orphix_dev@localhost:5432/orphix

# Redis
REDIS_URL=redis://localhost:6379

# JWT — MUST be set in production. Use a strong random secret (e.g. openssl rand -hex 32)
# Must match control API JWT_SECRET for token verification
JWT_SECRET=dev-jwt-secret-change-in-production

# Service URLs
CONTROL_API_URL=http://localhost:2605
LINK_API_URL=http://localhost:2606
WEB_APP_URL=http://localhost:3000
