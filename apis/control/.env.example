# Control API Environment Variables
# Copy to .env and fill in values

# Server
PORT=2605

# Database
DATABASE_URL=postgres://orphix:orphix_dev@localhost:5432/orphix

# Redis
REDIS_URL=redis://localhost:6379

# JWT — MUST be set in production. Use a strong random secret (e.g. openssl rand -hex 32)
JWT_SECRET=dev-jwt-secret-change-in-production

# Token encryption key — used to encrypt stored OAuth tokens at rest. Defaults to JWT_SECRET if not set.
# For production, generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:2605/auth/github/callback

# Allowed redirect URIs (comma-separated)
ALLOWED_REDIRECT_URIS=http://localhost:3000/auth/callback

# CORS origins (comma-separated, required in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Web App URL (for desktop login flow)
WEB_APP_URL=http://localhost:3000
