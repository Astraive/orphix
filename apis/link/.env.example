# Link API Environment Variables
# Copy to .env and fill in values

# Server
PORT=2606
HOST=0.0.0.0

# Database
DATABASE_URL=postgres://orphix:orphix_dev@localhost:5432/orphix

# Redis
REDIS_URL=redis://localhost:6379

# JWT — MUST be set in production. Use a strong random secret (e.g. openssl rand -hex 32)
JWT_SECRET=dev-jwt-secret-change-in-production

# CORS origins (comma-separated, required in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Control API URL (for device registration validation)
CONTROL_API_URL=http://localhost:2605
